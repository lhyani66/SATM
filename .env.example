# Copy this file to .env and fill in your values
# .env is gitignored and never committed

SECRET_KEY=change-this-to-a-long-random-string

# Local development uses SQLite by default — no setup needed.
DATABASE_URL=sqlite:///satm.db

# Production uses Neon PostgreSQL. Copy the connection string from the Neon
# dashboard and paste it into Render -> Environment -> DATABASE_URL.
# Never commit the real value. Format:
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>.neon.tech/<DATABASE>?sslmode=require
