# Copy this file to .env and fill in your values
# .env is gitignored and never committed

SECRET_KEY=change-this-to-a-long-random-string

# Local development uses SQLite by default — no setup needed.
DATABASE_URL=sqlite:///satm.db

# Production (Render) injects a PostgreSQL URL automatically via render.yaml.
# To point at a Postgres server yourself, use this format:
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>
